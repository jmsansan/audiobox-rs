      "css": ".ds-play{width:42px;height:42px;display:grid;place-items:center;padding:0;background:var(--ink,#202a50);color:white;border:0;border-radius:50%;cursor:pointer}.ds-play:hover{background:var(--accent,#6841cb)}.ds-play:focus-visible{outline:3px solid var(--accent,#6841cb);outline-offset:4px}.ds-play svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}"
